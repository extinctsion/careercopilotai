# CareerCopilot environment variables

# AI access via the Vercel AI Gateway (recommended).
# On Vercel/v0 this is provided automatically. For local dev, create a key at
# https://vercel.com/ai-gateway and set it here.
AI_GATEWAY_API_KEY=

# Or use Google Gemini AI directly by providing your Gemini API key:
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
